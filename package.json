{
  "name": "n8n-nodes-meshcentral",
  "version": "2.0.1",
  "description": "n8n node for MeshCentral integration via meshctrl.js",
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build && node scripts/copy-meshctrl.mjs",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier --write nodes credentials",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/MeshcentralApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MeshCentral/Meshcentral.node.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rallisf1/n8n-nodes-meshcentral.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "meshcentral"
  ],
  "author": {
    "name": "John Rallis",
    "email": "rallisf1@yahoo.gr"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rallisf1/n8n-nodes-meshcentral/issues"
  },
  "homepage": "https://github.com/rallisf1/n8n-nodes-meshcentral#readme",
  "dependencies": {
    "https-proxy-agent": "^5.0.1",
    "minimist": "^1.2.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.41.2",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "browser": {
    "child_process": false
  }
}
